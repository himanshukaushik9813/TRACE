{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@trace/strategy-ir": ["./packages/strategy-ir/src"],
      "@trace/uniswap-v3": ["./packages/uniswap-v3/src"],
      "@trace/strategy-inference": ["./packages/strategy-inference/src"],
      "@trace/backtester": ["./packages/backtester/src"],
      "@trace/aqua-adapter": ["./packages/aqua-adapter/src"],
      "@trace/world-auth": ["./packages/world-auth/src"],
      "@trace/zero-g-storage": ["./packages/zero-g-storage/src"],
      "@trace/chain-data": ["./packages/chain-data/src"]
    }
  },
  "include": [
    "server/src/**/*.ts",
    "packages/types/server-deps.d.ts",
    "packages/types/node-crypto.d.ts",
    "packages/types/viem.d.ts"
  ]
}

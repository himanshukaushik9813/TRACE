{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // Deliberately no "types": [] — a real build relies on @types/node
    // (installed at the workspace root) for `process`. The offline check
    // (tsconfig.server.json) instead pulls in packages/types/*.d.ts stubs.
  },
  "include": ["src/**/*.ts"]
}

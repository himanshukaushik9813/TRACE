# ─────────────────────────────────────────────────────────────────────────────
# TRACE — environment template (Ethereum Sepolia only)
#
# Copy to .env.local (gitignored) and fill in. The server reads it with
#   node --env-file=.env.local server/dist/index.js   (npm run start:server)
# and Next.js reads NEXT_PUBLIC_* values from the same file.
#
# Never commit real values. No variable here ever holds a user's wallet key:
# users sign in their own wallet (MetaMask). The only private key is the
# dedicated, testnet-only 0G Storage uploader (OG_STORAGE_PRIVATE_KEY).
# The server prints which variables are set at startup (never their values)
# and refuses to start on a non-Sepolia chain or a mainnet RPC URL.
# ─────────────────────────────────────────────────────────────────────────────

# ── Chain (required) ─────────────────────────────────────────────────────────
TRACE_CHAIN_ID=11155111
# Server-side Sepolia RPC (Infura / Alchemy / QuickNode). Never sent to the browser.
#   https://sepolia.infura.io/v3/<PROJECT_ID>
SEPOLIA_RPC_URL=
# Optional comma-separated failover Sepolia RPCs (paid/keyed endpoints recommended).
SEPOLIA_RPC_FALLBACK_URLS=
# Public address used by the owner for demos and fork tests (NOT a private key).
TRACE_OWNER_WALLET=

# ── Persistence (required) ───────────────────────────────────────────────────
# Postgres / Supabase. Supabase's direct host (db.<ref>.supabase.co) is IPv6-only;
# on IPv4 networks use the session pooler:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# "disable" for a local Postgres without TLS; anything else uses TLS.
DATABASE_SSL=require
# Redis for the BullMQ queue (Upstash: rediss://default:<token>@<host>:6379).
# Without it the queue runs in-process (reported as such; no durability).
REDIS_URL=
PORT=4000
# Browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── 0G Private Computer — inference via the 0G Router (OpenAI-compatible) ─────
# Key from https://pc.0g.ai (mainnet router) or https://pc.testnet.0g.ai (testnet router).
ZERO_G_ROUTER_URL=https://router-api.0g.ai/v1
ZERO_G_API_KEY=
# A chat model that the router can serve for your key's trust mode (see GET /v1/models).
ZERO_G_MODEL=glm-4.7
# Optional X-0G-Provider-Trust-Mode header: standard | verified | private. Leave empty
# to use the key's own setting (a key created in "private" mode only accepts private/TEE providers).
ZERO_G_TRUST_MODE=
# Ask the router to verify the provider's TEE signature (verify_tee). Default true.
ZERO_G_VERIFY_TEE=true

# ── 0G Storage — Galileo testnet (chainId 16602) ─────────────────────────────
OG_STORAGE_RPC_URL=https://evmrpc-testnet.0g.ai
OG_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
# DEDICATED burner key, testnet only, funded at https://faucet.0g.ai. Server-side only.
OG_STORAGE_PRIVATE_KEY=
OG_STORAGE_ADDRESS=

# ── World ID v4 (optional human-proof layer, staging) ────────────────────────
# From https://developer.world.org (app → World ID 4.0): app id, RP id, RP signing key.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=trace-authorize-execution
WORLD_ENVIRONMENT=staging

# ── Frontend (inlined into the browser bundle — public values only) ──────────
NEXT_PUBLIC_TRACE_API_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_ID=11155111
# Keyless public Sepolia RPC for browser reads (wallet RPC is used for writes).
NEXT_PUBLIC_SEPOLIA_PUBLIC_RPC=https://ethereum-sepolia-rpc.publicnode.com

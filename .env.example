# ─────────────────────────────────────────────────────────────────────────────
# TRACE — environment template
#
# Two layers read environment:
#   1. the Express + BullMQ server  (server/)  — the values in the "server"
#      section below
#   2. the Next.js web app          (src/)     — NEXT_PUBLIC_* only, inlined
#      into the browser bundle at build time
#
# Everything is optional for the hackathon demo path: with the 0G / World /
# storage endpoints unset, the pipeline runs its deterministic engines and the
# clearly-labelled demo fixtures, and the UI shows the "DEMO DATA" badge.
# Setting a real endpoint switches the corresponding step to live, and the
# result's `source` flips to "live" (the badge turns off for that run).
# ─────────────────────────────────────────────────────────────────────────────

# ── Server (Express API + BullMQ worker, single deployable) ────────────────────
# Postgres connection string. The schema lives in db/schema.sql and MUST be
# loaded before the API accepts traffic (the server exits otherwise).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trace

# BullMQ / ioredis. Any URL the ioredis parser accepts; host:port or redis://.
# Defaults to redis://localhost:6379 when unset.
REDIS_URL=redis://localhost:6379

# Port the API + worker listen on. Default 4000.
PORT=4000

# ── 0G Private Computer (strategy inference) ──────────────────────────────────
# A production inference endpoint would POST the deterministic evidence pack
# and return a structured Strategy IR *proposal*. TRACE then schema-validates
# it against the evidence before trusting it — the model is never the source
# of blockchain truth. Leave BOTH unset to run the labelled deterministic
# demo path (the pipeline result is flagged accordingly).
#
#   ZERO_G_ENDPOINT=https://api.0g.com/v1/inference
#   ZERO_G_API_KEY=your-key
ZERO_G_ENDPOINT=
ZERO_G_API_KEY=

# ── 0G Storage (archiving investigation artifacts) ────────────────────────────
# Live mode POSTs each artifact and records the returned reference. A failed
# live write is a hard error — it never silently degrades to a demo ref and
# calls it real. Leave unset for the labelled `0G-STOR-arc_… · demo` path.
#
#   ZERO_G_STORAGE_ENDPOINT=https://api.0g.com/v1/storage
#   ZERO_G_STORAGE_KEY=your-key
ZERO_G_STORAGE_ENDPOINT=
ZERO_G_STORAGE_KEY=

# ── World Agent Pass (human authorization) ────────────────────────────────────
# Hackathon demo key: the proof is bound to (worldId, strategy version,
# program hash, action, expiry, challenge) and signed with an HMAC demo key.
# The data shape is production-identical; swap the demo key for World's
# Ed25519 verification against the registry in production.
#
# WORLD_DEMO_ID=0x…your-world-id
# WORLD_DEMO_KEY=your-demo-key
WORLD_DEMO_ID=
WORLD_DEMO_KEY=

# ── Frontend (web app) ────────────────────────────────────────────────────────
# Point the UI at the TRACE server. Must be NEXT_PUBLIC_ so Next inlines it
# into the client bundle. Leave unset and every screen runs on the labelled
# fixture with the "DEMO DATA" badge on — the repeatable offline demo.
#
#   NEXT_PUBLIC_TRACE_API_URL=http://localhost:4000
NEXT_PUBLIC_TRACE_API_URL=

# ── Live chain reads ──────────────────────────────────────────────────────────
# The server fetches real Uniswap V3 lifecycle events through @trace/chain-data
# (viem) from this RPC endpoint. The key lives ONLY on the server — the browser
# talks to the API, never to the chain. Per-request rpcUrl still works and
# takes precedence; TRACE_RPC_URL is the default source.
#
#   TRACE_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR-KEY
TRACE_RPC_URL=

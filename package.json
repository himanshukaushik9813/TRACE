{
  "name": "trace-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "TRACE — On-Chain Strategy Intelligence on Ethereum Sepolia. Next.js app (src/) + engine packages (packages/) + Express/BullMQ server (server/).",
  "workspaces": [
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:server",
    "typecheck:frontend": "tsc -p tsconfig.typecheck.json",
    "typecheck:server": "npm run build:packages && tsc -p server/tsconfig.build.json --noEmit",
    "build:packages": "node scripts/build-packages.mjs",
    "build:server": "npm run build:packages && tsc -p server/tsconfig.build.json",
    "start:server": "node --env-file=.env.local server/dist/index.js",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "test": "npm run build:packages && node --test \"test/*.test.mjs\"",
    "test:unit": "node --test \"test/*.test.mjs\"",
    "test:live": "TRACE_LIVE_TESTS=1 node --env-file=.env.local --test \"test/live/*.test.mjs\"",
    "test:fork": "node --env-file=.env.local --test \"test/fork/*.test.mjs\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.13",
    "@1inch/aqua-sdk": "^0.4.0",
    "@1inch/swap-vm-sdk": "^0.5.0",
    "@tanstack/react-query": "^5.106.1",
    "@worldcoin/idkit": "^4.6.0",
    "@worldcoin/idkit-core": "^4.6.0",
    "ethers": "^6.13.1",
    "lucide-react": "^0.451.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.57.16",
    "wagmi": "^3.7.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.16.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  }
}

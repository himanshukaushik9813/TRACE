{
  "name": "trace-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "TRACE — On-Chain Strategy Intelligence. Next.js web app (src/) + deterministic engine packages (packages/) + Express/BullMQ server (server/).",
  "workspaces": [
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:packages && npm run typecheck:server",
    "typecheck:frontend": "tsc -p tsconfig.typecheck.json",
    "typecheck:packages": "tsc -p packages/tsconfig.check.json",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "typecheck:full": "tsc --noEmit",
    "build:packages": "node scripts/build-packages.mjs",
    "build:server": "npm run build:packages && cd server && tsc -p tsconfig.build.json",
    "start:server": "node server/dist/index.js",
    "test": "npm run build:packages && node --test \"test/*.test.mjs\"",
    "test:engines": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "lucide-react": "^0.451.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  }
}

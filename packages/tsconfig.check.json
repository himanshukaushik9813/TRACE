{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@trace/strategy-ir": [
        "./strategy-ir/src"
      ],
      "@trace/uniswap-v3": [
        "./uniswap-v3/src"
      ],
      "@trace/strategy-inference": [
        "./strategy-inference/src"
      ],
      "@trace/backtester": [
        "./backtester/src"
      ],
      "@trace/aqua-adapter": [
        "./aqua-adapter/src"
      ],
      "@trace/world-auth": [
        "./world-auth/src"
      ],
      "@trace/zero-g-storage": [
        "./zero-g-storage/src"
      ],
      "@trace/chain-data": [
        "./chain-data/src"
      ]
    }
  },
  "include": [
    "./strategy-ir/src/**/*.ts",
    "./uniswap-v3/src/**/*.ts",
    "./strategy-inference/src/**/*.ts",
    "./backtester/src/**/*.ts",
    "./aqua-adapter/src/**/*.ts",
    "./world-auth/src/**/*.ts",
    "./zero-g-storage/src/**/*.ts",
    "./chain-data/src/**/*.ts",
    "./types/node-crypto.d.ts",
    "./types/viem.d.ts",
    "./types/server-deps.d.ts"
  ]
}